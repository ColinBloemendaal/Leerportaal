APP_NAME=Leerportaal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# Leave unset in production: config/session.php already defaults it to
# true whenever APP_ENV=production, so this only needs setting to
# override that default (e.g. force it on somewhere non-production).

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis over phpredis: works everywhere without a compiled extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bounce/complaint webhook signature verification (App\Services\Mail\MailgunWebhookParser).
MAILGUN_WEBHOOK_SIGNING_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-compatible object storage endpoint (e.g. Hetzner Object Storage). Leave
# unset to use AWS S3 itself.
AWS_ENDPOINT=
AWS_URL=

# Mollie -- behind the PaymentGateway interface, see App\Contracts\Billing.
MOLLIE_KEY=

# Ploi API -- automated LetsEncrypt issuance for reseller custom domains.
PLOI_API_KEY=
PLOI_SERVER_ID=
PLOI_SITE_ID=

# Host reseller custom domains must CNAME to.
CUSTOM_DOMAIN_TARGET=tenants.leerportaal.test

# Sentry error tracking. PII must never reach it -- see CLAUDE.md §7.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# spatie/laravel-activitylog -- see App\Concerns\HasAuditLog.
ACTIVITYLOG_ENABLED=true
# ACTIVITYLOG_BUFFER_ENABLED=true

# Hard session limit for impersonation, see CLAUDE.md §7.
IMPERSONATION_SESSION_MINUTES=15

VITE_APP_NAME="${APP_NAME}"

# Optional: seeds a platform super-admin user when running `php artisan
# db:seed`. Leave both unset to skip. Never commit real values here.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
